# Server only: copy to supabase/functions/.env, which is ignored by Git.
# Add these through Supabase Dashboard > Edge Functions > Secrets when deploying.
PAYMOB_MODE=test
PAYMOB_BASE_URL=https://uae.paymob.com
PAYMOB_SECRET_KEY=
PAYMOB_PUBLIC_KEY=
PAYMOB_HMAC_SECRET=
PAYMOB_INTEGRATION_ID=
APP_URL=https://bedspace.thepercentagecompany.com
# Same Google Web OAuth client configured in Supabase Auth > Google.
# Server-only: never put the client secret in Flutter build variables.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Explicit test surcharges, in fils. Set approved production charges before launch.
PAYMOB_MONTHLY_EXTRA_CENTS=0
PAYMOB_ANNUAL_EXTRA_CENTS=0
# Supabase provides SUPABASE_URL, SUPABASE_ANON_KEY and
# SUPABASE_SERVICE_ROLE_KEY automatically to deployed functions.
