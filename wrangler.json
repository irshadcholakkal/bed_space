{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "bed-space",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-11-09",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "bedspace.thepercentagecompany.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./build/site",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/app", "/app/*", "/auth/callback", "/login", "/login/", "/signup", "/signup/",
      "/dashboard", "/dashboard/", "/rooms", "/rooms/*", "/financials", "/financials/",
      "/settings", "/settings/", "/buildings", "/buildings/", "/tenants", "/tenants/*",
      "/vacant-beds", "/vacant-beds/", "/billing", "/billing/*", "/admin", "/admin/",
      "/connect-google", "/connect-google/", "/features", "/features/", "/pricing", "/pricing/", "/guides", "/guides/"]
  }
}
