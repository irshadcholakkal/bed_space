# Google OAuth Web application client ID (public, compiled into the PWA).
GOOGLE_CLIENT_ID=
SUPABASE_URL=
# Public publishable/anon key only. Never use the service-role key here.
SUPABASE_ANON_KEY=

# Exact Flutter SDK version used by Cloudflare Pages.
FLUTTER_VERSION=3.47.2

# Set these in Cloudflare Pages build variables as well.
NODE_VERSION=22
SKIP_DEPENDENCY_INSTALL=true

# Do not add Google client secrets or service-account keys to the Flutter app.
# Google access tokens and Sheet IDs are managed per signed-in user by the app.
